# Application Environment (DEV / STAGING / PROD)
APP_NAME=Roomia
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
DEFAULT_CURRENCY=MXN
MAX_GUESTS_ALLOWED=20

# Database Persistence (PostgreSQL 16 - 3NF & PL/pgSQL Data Audit Triggers)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=roomia_db
DB_USERNAME=roomia_app_user
DB_PASSWORD=CHANGE_ME_IN_SECRETS_MANAGER

# Cache & Revocation Store (Redis 7.x)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cryptographic Hashing (RQ-SEG-001: Argon2id 64MB, t=4, p=2)
HASH_DRIVER=argon2id
ARGON2_MEMORY=65536
ARGON2_THREADS=2
ARGON2_TIME=4

# Asymmetric JWT Configuration (RQ-SEG-002: RSA-2048, 60 min TTL)
JWT_ALGO=RS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
JWT_PRIVATE_KEY_PATH=storage/certs/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/certs/jwt-public.pem

# External Providers (Section 33 - Injected via AWS Secrets Manager)
STRIPE_PUBLIC_KEY=pk_test_placeholder_injected_at_runtime
STRIPE_SECRET_KEY=sk_test_placeholder_injected_at_runtime
STRIPE_WEBHOOK_SECRET=whsec_placeholder_injected_at_runtime
AWS_S3_BUCKET=roomia-listings-media-staging
AWS_DEFAULT_REGION=us-east-1
MAPBOX_ACCESS_TOKEN=pk.mapbox_placeholder_injected_at_runtime
