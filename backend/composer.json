{
    "name": "roomia-org/roomia-backend",
    "description": "Roomia Core REST API - Clean Architecture (Laravel 11 / PHP 8.3)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
